{
  "name": "potterymania",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "build:ci": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke",
    "test:accessibility": "playwright test tests/e2e/accessibility/accessibility-baseline.spec.ts",
    "test:smoke": "npm run test:e2e:smoke -- --grep \"Flow 1|Flow 2|Route smoke\"",
    "test:e2e-role-matrix": "npm run test:e2e:smoke -- --grep \"Flow 1|Flow 2|Route smoke|checkout|booking|product\"",
    "test:api-contract": "vitest run lib/api-contract",
    "test:security": "npm run test:e2e:smoke -- --grep \"Flow 2|Route smoke\"",
    "test:load-smoke": "npm run test:e2e:smoke -- --grep \"checkout|booking\" --workers=1",
    "test:reconciliation": "node scripts/qa/reconciliation-check.cjs",
    "test:functionality": "npm run test:smoke && npm run test:e2e-role-matrix",
    "test:ux": "npm run test:e2e:smoke -- --grep \"Flow 1\"",
    "test:logic": "npm run test:e2e:smoke -- --grep \"checkout|booking|product\"",
    "test:performance": "npm run test:load-smoke",
    "test:business": "npm run test:e2e:smoke -- --grep \"checkout|booking\"",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "import:wear-csv": "node scripts/import-spod-wear-csv.cjs"
  },
  "dependencies": {
    "@playwright/test": "^1.59.1",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.47.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.0",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "next": "^15.5.15",
    "next-auth": "^5.0.0-beta.30",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.10.0",
    "sharp": "^0.34.5",
    "stripe": "^21.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.15",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "import-in-the-middle": "3.0.0"
  }
}
