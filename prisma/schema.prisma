// PotteryMania — aligned with DATABASE_SCHEMA.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  vendor
  admin
  hyper_admin
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  role            UserRole  @default(customer)
  lastLoginAt     DateTime? @map("last_login_at")
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason")
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// Abandoned-cart / marketing emails (opt-in).
  marketingConsent Boolean  @default(false) @map("marketing_consent")
  /// Hyperadmin-only labels (e.g. vip, at-risk). Lowercase slug segments; not shown to the user.
  adminTags       String[]  @default([]) @map("admin_tags")
  /// Opaque token for unauthenticated iCal/WebCal feed of this user’s bookings (`/api/calendar/feed/[token]`). Treat as secret.
  calendarFeedToken String?   @unique @map("calendar_feed_token")
  preferredLanguage String?   @map("preferred_language")
  detectedRegion    ShippingZone? @map("detected_region")
  regionOverride    ShippingZone? @map("region_override")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  ownedStudios         Studio[]              @relation("StudioOwner")
  customerProfile      CustomerProfile?
  carts                Cart[]
  orders               Order[]
  bookingsAsCustomer   Booking[]             @relation("BookingCustomer")
  bookingCancellations BookingCancellation[]
  bookingReschedules   BookingReschedule[]
  bookingAuditLogs     BookingAuditLog[]
  waitlistEntries      BookingWaitlistEntry[] @relation("WaitlistCustomer")
  reviews              Review[]
  financeLedgerEntries FinanceLedgerEntry[] @relation("LedgerUser")
  subscriptions        Subscription[]
  acquisitionAttributions AcquisitionAttribution[]
  featureUsageFacts    FeatureUsageFact[]
  discountRedemptions  DiscountRedemption[]
  giftCardsPurchased   GiftCard[]            @relation("GiftCardPurchaser")
  giftCardRedemptions  GiftCardRedemption[]  @relation("GiftCardRedeemer")
  bookSoonSent         BookSoonSent[]
  classPackagePurchases ClassPackagePurchase[]
  membershipPurchases  MembershipPurchase[]
  wearBuilderJobsCreated WearBuilderJob[]
  loyaltyBalances      LoyaltyBalance[]
  clientFieldResponses StudioClientFieldResponse[]
  loyaltyAdjustments   LoyaltyTransaction[] @relation("LoyaltyAdminUser")
  instructorProfiles   Instructor[]
  priceChangeHistory   PriceChangeHistory[]
  adminAuditLogs       AdminAuditLog[]
  pricingScenarios     PricingScenario[]
  adminNotesAuthored   AdminNote[]          @relation("AdminNoteAuthor")
  adminNotesReceived   AdminNote[]          @relation("AdminNoteTarget")
  passwordResetTokens       PasswordResetToken[]
  emailVerificationTokens   EmailVerificationToken[]
  rankingBoostsAuthored     RankingBoost[]           @relation("RankingBoostAuthor")
  insightPurchases          InsightPurchase[]
  offeringSubscriptions     OfferingSubscription[]
  featureSuggestions        FeatureSuggestion[]

  @@map("users")
}

/// One-time id consumed by Auth.js `session.update({ impersonationGrantId })` so only server-created grants can switch JWT `sub`.
model ImpersonationGrant {
  id           String   @id @default(uuid()) @db.Uuid
  adminUserId  String   @map("admin_user_id") @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([adminUserId])
  @@map("impersonation_grants")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model CustomerProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  fullName          String?  @map("full_name")
  phone             String?
  preferredLanguage String?  @map("preferred_language")
  preferredCurrency String?  @map("preferred_currency")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

enum StudioStatus {
  draft
  pending_review
  approved
  rejected
  suspended
}

enum StudioPlanKey {
  bookings
  shop
  both
  pro
}

/// Vendor gallery funnel — hyperadmin reporting, not billing.
enum BusinessTemplateFunnelEventType {
  gallery_view
  drawer_open
  activate_click
  activation_success
}

/// Hyperadmin-configurable studio “business template” catalog (growth / layout focus).
model BusinessTemplate {
  id                    String   @id @default(uuid()) @db.Uuid
  slug                  String   @unique
  name                  String
  tagline               String
  /// Short label distinguishing the business model (shown on cards).
  businessModelLabel    String   @map("business_model_label")
  bullets               Json
  priceCents            Int      @map("price_cents")
  currency              String   @default("EUR")
  isVisible             Boolean  @default(true) @map("is_visible")
  isFeatured            Boolean  @default(false) @map("is_featured")
  isPlatformRecommended Boolean  @default(false) @map("is_platform_recommended")
  isDefault             Boolean  @default(false) @map("is_default")
  sortOrder             Int      @default(0) @map("sort_order")
  /// Theme key mapped in UI (wear, amber, rose, teal, …).
  visualTheme           String   @default("wear") @map("visual_theme")
  newSetupSummary       String   @map("new_setup_summary") @db.Text
  currentSetupSummary   String   @map("current_setup_summary") @db.Text
  whatWillChange        Json     @map("what_will_change")
  expectedImpact        Json     @map("expected_impact")
  successGoalPhrase     String   @map("success_goal_phrase")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([isVisible, sortOrder])
  @@map("business_templates")
}

model BusinessTemplateFunnelEvent {
  id           String                        @id @default(uuid()) @db.Uuid
  studioId     String                        @map("studio_id") @db.Uuid
  templateSlug String?                       @map("template_slug")
  eventType    BusinessTemplateFunnelEventType @map("event_type")
  meta         Json?
  createdAt    DateTime                      @default(now()) @map("created_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId, createdAt])
  @@index([templateSlug])
  @@index([eventType, createdAt])
  @@map("business_template_funnel_events")
}

/// Rollback-safe audit trail of template switches (previous state in JSON).
model BusinessTemplateActivationLog {
  id                  String    @id @default(uuid()) @db.Uuid
  studioId            String    @map("studio_id") @db.Uuid
  previousSlug        String?   @map("previous_slug")
  previousActivatedAt DateTime? @map("previous_activated_at")
  newSlug             String    @map("new_slug")
  newActivatedAt      DateTime  @map("new_activated_at")
  previousSnapshot    Json?     @map("previous_snapshot")
  newSnapshot         Json?     @map("new_snapshot")
  createdAt           DateTime  @default(now()) @map("created_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId, createdAt])
  @@map("business_template_activation_logs")
}

model Studio {
  id                    String       @id @default(uuid()) @db.Uuid
  ownerUserId           String       @map("owner_user_id") @db.Uuid
  displayName           String       @map("display_name")
  legalBusinessName     String       @map("legal_business_name")
  vatNumber             String       @map("vat_number")
  responsiblePersonName String       @map("responsible_person_name")
  email                 String
  phone                 String?
  country               String
  city                  String
  addressLine1          String       @map("address_line_1")
  addressLine2          String?      @map("address_line_2")
  postalCode            String?      @map("postal_code")
  latitude              Float?
  longitude             Float?
  shortDescription      String?      @map("short_description")
  longDescription       String?      @map("long_description")
  logoUrl               String?      @map("logo_url")
  coverImageUrl         String?      @map("cover_image_url")
  instagramUrl          String?      @map("instagram_url")
  facebookUrl           String?      @map("facebook_url")
  websiteUrl            String?      @map("website_url")
  preferredLanguage     String?      @map("preferred_language")
  preferredCurrency     String?      @map("preferred_currency")
  supportedLanguages    String[]     @default(["en"]) @map("supported_languages")
  planKey               StudioPlanKey? @map("plan_key")
  status                StudioStatus
  rejectionReason       String?      @map("rejection_reason")
  approvedAt            DateTime?    @map("approved_at")
  /// Set when the vendor pays the one-time €5 activation fee via Stripe Checkout.
  activationPaidAt      DateTime?    @map("activation_paid_at")
  activationSessionId   String?      @map("activation_session_id")
  /// Stripe Customer on the platform account (studio add-on subscriptions).
  stripePlatformCustomerId String?   @map("stripe_platform_customer_id")
  /// Hyperadmin boost for marketplace / studio directory ordering (higher = earlier).
  marketplaceRankWeight Int          @default(0) @map("marketplace_rank_weight")
  /// Vendor-selected growth / layout template (catalog slug). Drives dashboard emphasis and onboarding copy.
  businessTemplateSlug      String?   @map("business_template_slug")
  businessTemplateActivatedAt DateTime? @map("business_template_activated_at")
  /// WhatsApp number for public contact button (E.164 format, e.g. +306940821618).
  whatsappNumber        String?                @map("whatsapp_number")
  /// Enable SMS notifications for booking lifecycle events.
  smsEnabled            Boolean                @default(false) @map("sms_enabled")
  twilioAccountSid      String?                @map("twilio_account_sid")
  twilioAuthToken       String?                @map("twilio_auth_token")
  twilioPhoneNumber     String?                @map("twilio_phone_number")
  /// Enable WhatsApp outbound notifications when templates/providers are configured.
  whatsappNotificationsEnabled Boolean         @default(false) @map("whatsapp_notifications_enabled")
  /// Enable optional tipping in checkout for class bookings.
  tipsEnabled            Boolean                @default(false) @map("tips_enabled")
  /// JSON opening hours, e.g. [{"day":"Monday","from":"10:00","to":"21:00","closed":false}, …]
  openingHours          Json?                  @map("opening_hours")
  /// IANA zone for class slot wall times (e.g. Europe/Paris). Drives Google Calendar + add-to-calendar links.
  ianaTimezone          String?                @map("iana_timezone")
  /// Curated public storefront theme (`/studios/:id` only). Validated in app; no raw hex / font uploads.
  publicTheme           Json?                  @map("public_theme")
  /// Per-service visibility on `/studios/:id`: hidden | visible | visible_link | active (+ optional linkUrl for visible_link).
  publicServiceModes    Json?                  @map("public_service_modes")
  dailyReportEnabled    Boolean                @default(false) @map("daily_report_enabled")
  dailyReportTime       String?                @default("08:00") @map("daily_report_time")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  owner                User                  @relation("StudioOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  products             Product[]
  experiences          Experience[]
  experienceAddOns     ExperienceAddOn[]
  intakeForms          IntakeForm[]
  giftCards            GiftCard[]
  coupons              Coupon[]
  giftCardTemplates    GiftCardTemplate[]
  classPackages        ClassPackage[]
  memberships         Membership[]
  invoices            Invoice[]
  notificationTemplates NotificationTemplate[]
  galleryImages       StudioGalleryImage[]
  posts               StudioPost[]
  instructors         Instructor[]
  calendarNotes       CalendarNote[]
  locations           StudioLocation[]
  bookSoonRules        BookSoonRule[]
  loyaltyConfig        LoyaltyConfig?
  loyaltyBalances      LoyaltyBalance[]
  clientFields         StudioClientField[]
  cancellationPolicies CancellationPolicy[]
  bookings             Booking[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  stripeAccount        StripeAccount?
  commissionRules      CommissionRule[]
  calendarConnections  CalendarConnection[]
  vendorDomains        VendorDomain[]
  analyticsSnapshots   AnalyticsSnapshot[]
  dateBlocks           StudioDateBlock[]
  waitlistEntries      BookingWaitlistEntry[]
  reviews              Review[]
  referralInvites      ReferralInvite[]        @relation("ReferralInviter")
  referredStudios      ReferralInvite[]        @relation("ReferralAcceptedStudio")
  shippingRateQuotes   ShippingRateQuote[]
  financeLedgerEntries FinanceLedgerEntry[] @relation("LedgerStudio")
  featureUsageFacts    FeatureUsageFact[]
  kilnFirings               KilnFiring[]
  studioFeatureRequests            StudioFeatureRequest[]
  studioFeatureActivations         StudioFeatureActivation[]
  studioFeatureActivationEvents    StudioFeatureActivationEvent[]
  rankingScore                     StudioRankingScore?
  rankingBoosts                    RankingBoost[]
  featuredPlacements               FeaturedPlacement[]
  generatedInsights                GeneratedInsight[]
  insightPurchases                 InsightPurchase[]
  insightActionLogs                InsightActionLog[]
  studioContacts                   StudioContact[]
  translations                    StudioTranslation[]
  businessTemplateFunnelEvents     BusinessTemplateFunnelEvent[]
  businessTemplateActivationLogs   BusinessTemplateActivationLog[]
  offeringSubscriptions            OfferingSubscription[]
  wearConfig                        StudioWearConfig?
  studioWearProducts                StudioWearProduct[]
  wearOrders                        WearOrder[]

  @@index([ownerUserId])
  @@index([status])
  @@index([country, city])
  @@index([marketplaceRankWeight])
  @@map("studios")
}

/// Admin- or campaign-applied lift to the manual component of ranking (Prompt 4).
enum RankingBoostType {
  featured
  seasonal
  manual
  paid
}

/// Curated slots on public surfaces (homepage, category rails, etc.).
enum FeaturedPlacementSlot {
  homepage_hero
  category_top
  trending
  seasonal
}

/// One row per studio; upserted by the ranking cron (`P4-B`).
model StudioRankingScore {
  id               String   @id @default(uuid()) @db.Uuid
  studioId         String   @unique @map("studio_id") @db.Uuid
  performanceScore Float    @default(0) @map("performance_score")
  activityScore    Float    @default(0) @map("activity_score")
  manualBoost      Float    @default(0) @map("manual_boost")
  compositeScore   Float    @default(0) @map("composite_score")
  percentileRank   Int      @default(0) @map("percentile_rank")
  scoreBreakdown   Json?    @map("score_breakdown")
  calculatedAt     DateTime @default(now()) @map("calculated_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([compositeScore(sort: Desc)])
  @@map("studio_ranking_scores")
}

model RankingBoost {
  id              String           @id @default(uuid()) @db.Uuid
  studioId        String           @map("studio_id") @db.Uuid
  boostType       RankingBoostType @map("boost_type")
  boostValue      Float            @map("boost_value")
  reason          String?
  startsAt        DateTime         @map("starts_at")
  endsAt          DateTime?        @map("ends_at")
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")

  studio    Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("RankingBoostAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([studioId])
  @@index([startsAt, endsAt])
  @@map("ranking_boosts")
}

model FeaturedPlacement {
  id            String                @id @default(uuid()) @db.Uuid
  studioId      String                @map("studio_id") @db.Uuid
  placementSlot FeaturedPlacementSlot @map("placement_slot")
  sortOrder     Int                   @default(0) @map("sort_order")
  startsAt      DateTime              @map("starts_at")
  endsAt        DateTime?             @map("ends_at")
  isActive      Boolean               @default(true) @map("is_active")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([placementSlot, isActive, sortOrder])
  @@index([studioId])
  @@map("featured_placements")
}

model ProductCategory {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  slug             String   @unique
  shortDescription String   @map("short_description")
  longDescription  String   @map("long_description") @db.Text
  imageUrl         String   @map("image_url")
  icon             String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

enum CeramicCategory {
  tableware
  decorative_objects
  vases_and_plant_pots
  lighting
  kitchen_and_serving
  coffee_and_tea
  bathroom_and_wellness
  jewelry_and_small_objects
  outdoor_and_garden
  ritual_and_artistic_pieces
}

enum ProductStockStatus {
  in_stock
  out_of_stock
  backorder
}

enum ProductStatus {
  draft
  active
  inactive
  archived
}

enum OfferingPricingType {
  one_time
  recurring
}

enum OfferingBillingInterval {
  weekly
  monthly
  custom
}

enum OfferingFailedPaymentAction {
  pause
  cancel
}

/// Native PotteryMania wear catalog — not studio `Product`; no marketplace cart mixing.
enum WearOrderStatus {
  pending
  paid
  manual_review
  in_production
  fulfilled
  shipped
  cancelled
  refunded
}

enum WearFulfillmentJobStatus {
  pending
  processing
  succeeded
  failed
  cancelled
}

enum WearCatalogPublishStatus {
  draft
  published
  hidden
}

enum WearAssetHealthStatus {
  pending
  ready
  invalid
}

/// Background queue for Level 2 Spreadconnect “catalog builder” (draft-first); worker execution added incrementally.
enum WearBuilderJobState {
  queued
  validating
  uploading_design
  creating_article
  syncing
  draft_ready
  failed
  published
  cancelled
}

model WearProduct {
  id                    String   @id @default(uuid()) @db.Uuid
  slug                  String   @unique
  name                  String
  subtitle              String?
  /// Long-form HTML-safe plain text or markdown-as-plain; rendered with whitespace preserved on PDP.
  description           String?  @db.Text
  priceCents            Int      @map("price_cents")
  currency              String   @default("EUR")
  /// Public image URLs (e.g. HTTPS), ordered. First = primary / Stripe image.
  images                Json
  sortOrder             Int      @default(0) @map("sort_order")
  isActive              Boolean  @default(true) @map("is_active")
  isFeatured            Boolean  @default(false) @map("is_featured")
  publishStatus         WearCatalogPublishStatus @default(published) @map("publish_status")
  assetHealthStatus     WearAssetHealthStatus @default(pending) @map("asset_health_status")
  assetHealthMessage    String?  @map("asset_health_message") @db.Text
  /// Soft-archive: hidden from storefront and default admin list until restored.
  archivedAt            DateTime? @map("archived_at")
  /// When the product has no variants: Spreadconnect article variant SKU for auto-fulfilment. Otherwise use variant.sku.
  externalFulfillmentId String?  @map("external_fulfillment_id")
  /// Spreadconnect `Article.id` — used for GET /articles/{id} refresh without listing the full catalog.
  spreadconnectArticleId            Int?    @unique @map("spreadconnect_article_id")
  /// Dominant Spreadconnect product type backing this article.
  spreadconnectProductTypeId        Int?    @map("spreadconnect_product_type_id")
  /// Readable product type name from the Spreadconnect article variant payload.
  spreadconnectProductTypeName      String? @map("spreadconnect_product_type_name")
  /// Spreadconnect `/productTypes/{productTypeId}/categories` payload for storefront filters.
  spreadconnectCategoryData         Json?   @map("spreadconnect_category_data")
  /// SHA-256 (hex) of synced catalog fields; unchanged fingerprints skip DB writes.
  spreadconnectCatalogFingerprint   String? @map("spreadconnect_catalog_fingerprint") @db.VarChar(64)
  /// Optional COGS floor (cents). Discounts cannot reduce unit price below this when set.
  supplyCostCents       Int?     @map("supply_cost_cents")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  variants           WearProductVariant[]
  cartItems          CartItem[]
  checkoutOrderItems OrderItem[]
  orderItems         WearOrderItem[]
  studioWearProducts StudioWearProduct[]
  wearBuilderJobs    WearBuilderJob[]

  @@index([isActive, sortOrder])
  @@index([archivedAt])
  @@index([spreadconnectProductTypeId])
  @@map("wear_products")
}

model WearProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  wearProductId String   @map("wear_product_id") @db.Uuid
  label         String
  sku           String?
  optionSize    String?  @map("option_size")
  optionColor   String?  @map("option_color")
  /// When null, inherits `WearProduct.priceCents`.
  priceCents    Int?     @map("price_cents")
  /// When null, stock is not tracked for this variant.
  stockQuantity Int?     @map("stock_quantity")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product    WearProduct     @relation(fields: [wearProductId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  checkoutOrderItems OrderItem[]
  orderItems WearOrderItem[]

  @@index([wearProductId, sortOrder])
  @@map("wear_product_variants")
}

enum CouponChannel {
  general
  wear_only
  marketplace_only
}

enum WearCouponDiscountMode {
  standard
  bundle
}

model WearOrder {
  id                      String          @id @default(uuid()) @db.Uuid
  /// Studio that referred this sale (null = direct platform purchase).
  studioId                String?         @map("studio_id") @db.Uuid
  couponId                String?         @map("coupon_id") @db.Uuid
  /// Subtotal in cents after affiliate markup, before coupon discount.
  preDiscountSubtotalCents Int?         @map("pre_discount_subtotal_cents")
  /// Coupon discount applied to merchandise subtotal (cents).
  discountCents           Int             @default(0) @map("discount_cents")
  orderId                 String?         @unique @map("order_id") @db.Uuid
  stripeCheckoutSessionId String?         @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?         @map("stripe_payment_intent_id")
  customerEmail           String          @map("customer_email")
  customerName            String          @map("customer_name")
  status                  WearOrderStatus @default(pending)
  subtotalCents           Int             @map("subtotal_cents")
  shippingCents           Int             @default(0) @map("shipping_cents")
  /// Stripe `amount_total` when checkout completes (includes shipping); null until paid.
  amountTotalCents        Int?            @map("amount_total_cents")
  /// Studio margin earned on this order (cents). Calculated at checkout time.
  studioMarginCents       Int?            @map("studio_margin_cents")
  /// Platform revenue after studio margin (cents).
  platformRevenueCents    Int?            @map("platform_revenue_cents")
  currency                String          @default("EUR")
  /// When payment succeeded (Stripe webhook or rare admin override).
  paidAt                  DateTime?       @map("paid_at")
  fulfilledAt             DateTime?       @map("fulfilled_at")
  shippedAt               DateTime?       @map("shipped_at")
  cancelledAt             DateTime?       @map("cancelled_at")
  refundedAt              DateTime?       @map("refunded_at")
  fulfillmentProvider     String?         @map("fulfillment_provider")
  trackingNumber          String?         @map("tracking_number")
  internalNotes           String?         @map("internal_notes") @db.Text
  /// External provider order / job id (distinct from catalog `WearProduct.externalFulfillmentId`).
  externalFulfillmentRef  String?         @map("external_fulfillment_ref")
  fulfillmentStatusDetail String?         @map("fulfillment_status_detail")
  fulfillmentLastError    String?         @map("fulfillment_last_error") @db.Text
  fulfillmentLastAttemptAt DateTime?      @map("fulfillment_last_attempt_at")
  fulfillmentSucceededAt  DateTime?       @map("fulfillment_succeeded_at")
  createdAt               DateTime        @default(now()) @map("created_at")
