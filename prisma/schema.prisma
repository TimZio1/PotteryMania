  classPackageUsages   ClassPackageUsage[]
  membershipLinks      MembershipExperience[]
  notificationTemplates NotificationTemplate[]
  instructorLinks      InstructorExperienceLink[]
  cartItems            CartItem[]
  waitlistEntries      BookingWaitlistEntry[]
  reviews              Review[]
  offeringSubscriptions OfferingSubscription[]

  @@unique([studioId, slug])
  @@index([studioId])
  @@index([status])
  @@map("experiences")
}

