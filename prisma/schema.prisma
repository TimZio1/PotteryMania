}

model StudioFeatureActivationEvent {
  id                        String                           @id @default(uuid()) @db.Uuid
  studioId                  String                           @map("studio_id") @db.Uuid
  featureId                 String                           @map("feature_id") @db.Uuid
  kind                      StudioFeatureActivationEventKind
  stripeSubscriptionId      String?                          @map("stripe_subscription_id")
  /// Set for `checkout_*` kinds — unique per feature + session so Stripe webhook retries do not duplicate rows.
  stripeCheckoutSessionId   String?                          @map("stripe_checkout_session_id")
  payloadJson               Json?                            @map("payload_json")
  createdAt                 DateTime                         @default(now()) @map("created_at")

  studio  Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  feature PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@index([featureId, createdAt])
  @@index([createdAt])
  @@unique([featureId, stripeCheckoutSessionId], map: "studio_feature_activation_events_feature_checkout_session_key")
  @@map("studio_feature_activation_events")
}

model StudioFeatureActivation {
  id                         String                        @id @default(uuid()) @db.Uuid
  studioId                   String                        @map("studio_id") @db.Uuid
  featureId                  String                        @map("feature_id") @db.Uuid
  status                     StudioFeatureActivationStatus @default(inactive)
  trialEndsAt                DateTime?                     @map("trial_ends_at")
  deactivatesAt              DateTime?                     @map("deactivates_at")
  /// Stripe Subscription id for this add-on when billed separately (one sub per feature).
  stripeSubscriptionId       String?                       @map("stripe_subscription_id")
  stripeSubscriptionItemId   String?                       @map("stripe_subscription_item_id")
  overridePriceCents         Int?                          @map("override_price_cents")
  activatedAt                DateTime?                     @map("activated_at")
  createdAt                  DateTime                      @default(now()) @map("created_at")
  updatedAt                  DateTime                      @updatedAt @map("updated_at")

  studio  Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  feature PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([studioId, featureId])
  @@index([studioId])
  @@index([featureId])
  @@index([stripeSubscriptionId])
  @@map("studio_feature_activations")
}

/// Hyperadmin-defined bundle of catalog features (discounted package price vs à la carte).
model FeatureBundle {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  name        String
  description String    @default("")
  priceCents  Int       @map("price_cents")
  currency    String    @default("EUR")
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  validFrom   DateTime? @map("valid_from")
  validUntil  DateTime? @map("valid_until")
  /// Optional single recurring Stripe Price for the whole bundle (platform Billing).
  stripePriceId String?   @map("stripe_price_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  items FeatureBundleItem[]

  @@index([isActive])
  @@map("feature_bundles")
}

model FeatureBundleItem {
  id        String @id @default(uuid()) @db.Uuid
  bundleId  String @map("bundle_id") @db.Uuid
  featureId String @map("feature_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  bundle  FeatureBundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  feature PlatformFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([bundleId, featureId])
  @@index([bundleId])
  @@index([featureId])
  @@map("feature_bundle_items")
}

/// Vendor CRM row: notes/tags + manual contacts, merged with booking history (P1-D).
model StudioContact {
  id              String   @id @default(uuid()) @db.Uuid
  studioId        String   @map("studio_id") @db.Uuid
  emailNormalized String   @map("email_normalized")
  displayName     String   @map("display_name")
  phone           String?
  notes           String?  @db.Text
  tags            String[] @default([])
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, emailNormalized])
  @@index([studioId])
  @@map("studio_contacts")
}

// --- AI monetized insights (Prompt 3) ---

enum InsightTemplateCategory {
  pricing
  schedule
  demand
  retention
  revenue
  capacity
  feature_rec
}

enum InsightComplexity {
  simple
  medium
  advanced
}

enum GeneratedInsightStatus {
  generated
  viewed
  purchased
  expired
  dismissed
}

enum InsightActionType {
  applied
  dismissed
  viewed_editor
  deferred
}

model InsightTemplate {
  id             String                  @id @default(uuid()) @db.Uuid
  slug           String                  @unique
  category       InsightTemplateCategory
  title          String
  previewText    String                  @map("preview_text")
  analysisPrompt String                  @default("") @map("analysis_prompt")
  basePriceCents Int                     @map("base_price_cents")
  complexity     InsightComplexity       @default(simple)
  isActive       Boolean                 @default(true) @map("is_active")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  generatedInsights GeneratedInsight[]

  @@map("insight_templates")
}

model GeneratedInsight {
  id                  String                 @id @default(uuid()) @db.Uuid
  studioId            String                 @map("studio_id") @db.Uuid
  templateId          String                 @map("template_id") @db.Uuid
  previewTitle        String                 @map("preview_title")
  previewHook         String                 @map("preview_hook")
  potentialBenefit    String                 @default("") @map("potential_benefit")
  priceCents          Int                    @map("price_cents")
  fullAnalysis        Json?                  @map("full_analysis")
  status              GeneratedInsightStatus @default(generated)
  confidenceScore     Float?                 @map("confidence_score")
  benchmarkSampleSize Int?                   @map("benchmark_sample_size")
  generatedAt         DateTime               @default(now()) @map("generated_at")
  expiresAt           DateTime?              @map("expires_at")
  purchasedAt         DateTime?              @map("purchased_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  studio     Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  template   InsightTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  purchase   InsightPurchase?
  actionLogs InsightActionLog[]

  @@index([studioId])
  @@index([templateId])
  @@map("generated_insights")
}

model InsightPurchase {
  id                    String   @id @default(uuid()) @db.Uuid
  insightId             String   @unique @map("insight_id") @db.Uuid
  studioId              String   @map("studio_id") @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  amountCents           Int      @map("amount_cents")
  stripePaymentIntentId String?  @map("stripe_payment_intent_id")
  createdAt             DateTime @default(now()) @map("created_at")

  insight GeneratedInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  studio  Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("insight_purchases")
}

model InsightActionLog {
  id         String            @id @default(uuid()) @db.Uuid
  insightId  String            @map("insight_id") @db.Uuid
  studioId   String            @map("studio_id") @db.Uuid
  actionType InsightActionType @map("action_type")
  metadata   Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  insight GeneratedInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  studio  Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([insightId])
  @@map("insight_action_logs")
}

/// Tier 4F: A/B experiment definition; assignment uses deterministic hashing in `lib/experiment-assign.ts`.
model Experiment {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  name            String
  isActive        Boolean  @default(true) @map("is_active")
  /// Share 0–100 for variant B; variant A gets the remainder.
  variantBPercent Int      @default(50) @map("variant_b_percent")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("experiments")
}

/// Tier 5E: Hyperadmin in-app notifications.
model AdminNotification {
  id        String    @id @default(uuid()) @db.Uuid
  title     String
  body      String?
  level     String    @default("info")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([readAt])
  @@index([createdAt(sort: Desc)])
  @@map("admin_notifications")
}

/// Admin email inbox: inbound support/affiliate/legal mail plus outbound replies.
model AdminInboxMessage {
  id                String    @id @default(uuid()) @db.Uuid
  direction         String    @default("inbound")
  mailbox           String    @default("support")
  fromEmail         String    @map("from_email")
  fromName          String?   @map("from_name")
  toEmail           String    @map("to_email")
  subject           String
  textBody          String?   @map("text_body") @db.Text
  htmlBody          String?   @map("html_body") @db.Text
  providerMessageId String?   @unique @map("provider_message_id")
  threadKey         String?   @map("thread_key")
  inReplyToId       String?   @map("in_reply_to_id") @db.Uuid
  sentByUserId      String?   @map("sent_by_user_id") @db.Uuid
  readAt            DateTime? @map("read_at")
  savedAt           DateTime? @map("saved_at")
  deletedAt         DateTime? @map("deleted_at")
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([direction, createdAt(sort: Desc)])
  @@index([mailbox, createdAt(sort: Desc)])
  @@index([readAt])
  @@index([savedAt])
  @@index([deletedAt])
  @@index([threadKey])
  @@map("admin_inbox_messages")
}

/// Stripe webhook delivery deduplication (`evt_…` id). `processedAt` set after handler succeeds.
model StripeWebhookEvent {
  id          String    @id
  eventType   String    @map("event_type")
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  failedAt    DateTime? @map("failed_at")
  retryCount  Int       @default(0) @map("retry_count")
  payload     Json?

  tasks StripeWebhookEventTask[]

  @@index([processedAt])
  @@index([failedAt])
  @@index([receivedAt(sort: Desc)])
  @@map("stripe_webhook_events")
}

model StripeWebhookEventTask {
  id                    String    @id @default(uuid()) @db.Uuid
  stripeWebhookEventId  String    @map("stripe_webhook_event_id")
  concern               String
  failedAt              DateTime? @map("failed_at")
  failureReason         String?   @map("failure_reason") @db.Text
  resolvedAt            DateTime? @map("resolved_at")

  event StripeWebhookEvent @relation(fields: [stripeWebhookEventId], references: [id], onDelete: Cascade)

  @@index([stripeWebhookEventId])
  @@index([failedAt])
  @@map("stripe_webhook_event_tasks")
}
