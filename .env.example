# PostgreSQL (Railway)
# Use the Postgres plugin "Connection" / "Private URL" (postgresql://...:5432/...).
# P1013 "invalid port" on deploy = malformed URL: wrong variable, unescaped password (@ : /),
# quotes inside the value, or prisma+postgres:// (use plain postgresql:// on Railway).
# Meta Pixel (browser) + Conversions API (server Lead on /early-access)
NEXT_PUBLIC_META_PIXEL_ID=""
# Events Manager → your Pixel → Settings → Conversions API → Generate access token (Railway: secret)
FB_CONVERSIONS_API=""
# Optional: same pixel ID server-only (otherwise NEXT_PUBLIC_META_PIXEL_ID is used)
# META_PIXEL_ID=""
# Optional: Events Manager → Test events → copy code; shows only in Test tab
# FB_CAPI_TEST_EVENT_CODE=""

# Google Analytics (public, safe to commit)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# Optional: comma-separated domains for GA4 cross-domain linker (single-property tracking across brands)
# NEXT_PUBLIC_GA_LINK_DOMAINS="clayense.com,potterymania.com"
# Numeric Property ID from GA → Admin → Property settings (enables Realtime / Acquisition links in /admin)
NEXT_PUBLIC_GA4_PROPERTY_ID=""
# Optional label in admin GA4 panel (e.g. stream name)
NEXT_PUBLIC_GA_STREAM_LABEL=""

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js / NextAuth v5 — REQUIRED in production: non-empty AUTH_SECRET or NEXTAUTH_SECRET.
# If missing or "", /api/auth/session returns 500 ("problem with the server configuration").
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# NEXTAUTH_SECRET=""
# Production: backoffice/base origin only (e.g. https://app.yourbrand.com) — no path; wrong path breaks auth routes.
AUTH_URL="http://localhost:3000"
# NEXTAUTH_URL=""
# Optional split-domain mode:
# - FRONTDESK_SITE_URL: customer storefront + booking domain (e.g. https://clayense.com)
# - BACKOFFICE_SITE_URL: studio/admin/hyperadmin domain (usually same as AUTH_URL)
# FRONTDESK_SITE_URL=""
# BACKOFFICE_SITE_URL=""

# Optional: Google provider for Auth.js (do NOT use GOOGLE_CLIENT_ID on Railway — Railpack expects GOOGLE_CLIENT_ID_SECRET too).
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Stripe (Phase 1 checkout)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Spreadshop storefront URL for /wear (“Enter shop”, “View full collection”). Same-tab redirect. Public on purpose.
# Not the same as SPREADCONNECT_API_KEY (that’s the print/API integration).
NEXT_PUBLIC_SPREADSHOP_URL=""

# Reseller program CTA on /wear (“Join reseller program”): external application URL (Typeform, HubSpot, etc.) or an internal path (e.g. /early-access). Opens in a new tab when http(s). If empty, the button goes to sign-up with shop setup.
NEXT_PUBLIC_WEAR_RESELLER_APPLICATION_URL=""

# Spreadconnect (fulfilment / API) — key from Spreadconnect App → Integrations → Spreadconnect API → Connect
# Setup: https://faq.spreadconnect.app/hc/en-us/sections/360005512680-Setting-up-the-API | API docs: https://api.spreadconnect.app/docs/
# Railway: you can set SPREADCONNECT_API_KEY to a non-secret placeholder (e.g. __PENDING__) until you paste the real key.
SPREADCONNECT_API_KEY=""
# Optional. Staging uses a separate login: https://login.spreadconnect-staging.app/
SPREADCONNECT_API_BASE_URL="https://api.spreadconnect.app"
# Used as Spreadconnect order phone when Stripe Checkout did not collect one (prefer enabling phone on wear checkout).
SPREADCONNECT_FALLBACK_PHONE=""
# OpenAPI requires 2-letter state/province for US / CA when Stripe omits subdivision (see docs/reference/spreadconnect-openapi.json Address.state).
SPREADCONNECT_FALLBACK_US_STATE=""
SPREADCONNECT_FALLBACK_CA_PROVINCE=""

# Resend — orders, bookings, early-access, password-reset, email-verification (skipped if RESEND_API_KEY is empty)
RESEND_API_KEY=""
# Verified domain sender, e.g. PotteryMania <hello@mail.yourdomain.com> (Resend dashboard → Domains)
RESEND_FROM="PotteryMania <onboarding@resend.dev>"
# Canonical public/customer URL (frontdesk); used in customer links, email footers, and logo URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Server-to-server origin for Edge middleware to call /api/vendor-domains/resolve (custom studio domains). In production set to your primary https origin.
# INTERNAL_APP_ORIGIN="https://your-domain.com"
# Optional: require this header value on resolve API (middleware sends it automatically)
# VENDOR_DOMAIN_RESOLVE_SECRET=""
# Inbox for catalog leads + new account alerts (overrides production default). If unset in production, alerts go to the configured operations address in code unless you set one of the fallbacks below.
REGISTRATION_NOTIFY_EMAIL=""
# Inbox for “new early access signup” alerts (studio + email + country). Falls back to HYPERADMIN_ALERT_EMAIL, then SEED_HYPER_ADMIN_EMAIL.
EARLY_ACCESS_NOTIFY_EMAIL=""
# Inbox for feature suggestions from /suggest-feature. Falls back to HYPERADMIN_ALERT_EMAIL, then SEED_HYPER_ADMIN_EMAIL.
FEATURE_SUGGESTION_NOTIFY_EMAIL=""
# Shared fallback inbox for admin alerts (feature ideas, leads, wear-order escalations). Set once and forget.
HYPERADMIN_ALERT_EMAIL=""

# Preregistration: shop, classes, and studio directory hidden from guests and customers.
# Vendors + admins may still browse. Default: ON in production, OFF in dev.
# PREREGISTRATION_ONLY=1

# Cron jobs (abandoned carts, booking reminders, finance reconcile, …)
# Use the same secret in Authorization: Bearer <CRON_SECRET> when calling /api/cron/*
CRON_SECRET=""
# Optional: signed OAuth state for Google Calendar connect (defaults to CRON_SECRET)
# CALENDAR_OAUTH_SECRET=""

# Google Calendar — vendor connect at /dashboard/[studioId]/settings (OAuth calendar.events)
# Google Cloud Console → OAuth client (Web). Redirect URI: https://YOUR_ORIGIN/api/calendar/google/callback
# GOOGLE_CALENDAR_CLIENT_ID=""
# GOOGLE_CALENDAR_CLIENT_SECRET=""
# Optional if redirect differs from {AUTH_URL}/api/calendar/google/callback
# GOOGLE_CALENDAR_REDIRECT_URI=""

# OpenAI — studio AI Advisor chat (/api/studios/.../ai/chat)
OPENAI_API_KEY=""
# Optional model override (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Hyper admin account (prereg mode blocks /register — use seed once per DB, then /login)
# Railway: set both, then run once: npx prisma db seed  (or add "prisma db seed" after migrate in deploy)
SEED_HYPER_ADMIN_EMAIL=
SEED_HYPER_ADMIN_PASSWORD=

# --- Playwright E2E (tests/e2e/smoke) ---
# App must be reachable at BASE_URL with a working DATABASE_URL (same as Next dev server).
# BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_BASE_URL=   # alias; if set, webServer is not auto-started
# TEST_EMAIL=
# TEST_PASSWORD=
# TEST_VENDOR_EMAIL=     # optional override for product-create
# TEST_VENDOR_PASSWORD=
# TEST_STUDIO_ID=        # UUID for /dashboard/products/[studioId]
# TEST_EXPERIENCE_ID=    # UUID for /classes/[experienceId] (public active experience)
# TEST_PRODUCT_ID=       # optional marketplace deep-link tests
# TEST_ADMIN_EMAIL=      # optional: early-access lead visible on /admin
# TEST_ADMIN_PASSWORD=
# STRIPE_TEST_CARD=4242424242424242

